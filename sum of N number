3. # sum of factorial of N numbers

def fact(n):
    if n==0 or n==1:
        return 1
    if n>1:
        return n*fact(n-1)
        
# main funtion
num=int(input("enter the number:"))
sum=0
for i in range(1,num+1):
    sum+=fact(i)
print(sum)

output:
enter the limit:5
sum of N natural numbers: 153
