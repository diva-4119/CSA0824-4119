3.Write a Python program to find the sum of digits in a number.
def sumdigit(n):
  sum=0
  temp=n
  while temp>0:
    digit=temp%10
    sum+=digit
    temp=temp//10
  print(sum)
  
x=int(input())
sumdigit(x)

4. Write a Python program to check if a number is a palindrome or not.
def palindrome(n):
	org=n
	rev=0
	while n>0:
	  digit=n%10
	  rev=rev*10+digit
	  n=n//10
	if org==rev:
	  print("it a palindrome")
	else:
	  print("Not a palindrome")
x=int(input())
palindrome(x)

