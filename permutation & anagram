1.permutation
def getper(string,i=0):
    if i == len(string):
        print("".join(string))
    for j in range (i,len(string)):
        word=[c for c in string ]
        
        word[i],word[j]=word[j],word[i]
        getper(word,i+1)

print(getper('123'))

